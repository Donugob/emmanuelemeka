---
import SectionHead from "./SectionHead.astro";
import { media } from "../data/cv";
---

<section id="media" class="cv-section" aria-labelledby="media-h">
  <SectionHead id="media" />

  <div class="cv-group">
    {
      media.map((channel) => (
        <article>
          <div class="entry-head">
            <h3 class="text-[1.0625rem] font-medium">{channel.name}</h3>
            <p class="meta">{channel.platform}</p>
          </div>
          <p class="mt-0.5 text-ink-2">{channel.role}</p>
          <p class="measure mt-1.5 text-ink-2">{channel.blurb}</p>
        </article>
      ))
    }
  </div>
</section>
