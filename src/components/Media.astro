---
import SectionLabel from "./SectionLabel.astro";

const channels = [
  {
    name: "Street Saga Podcast",
    blurb:
      "Live X Spaces on tech careers, rights advocacy, engineering craft, and cultural dynamics.",
    platform: "X Spaces",
  },
  {
    name: "NaijaLawExplained",
    blurb:
      "Statutory law, demystified — visual guides and video for everyday Nigerians.",
    platform: "YouTube & social",
  },
];
---

<section
  id="media"
  class="section-pad border-t border-line py-20 sm:py-28"
  aria-labelledby="media-heading"
>
  <div class="section-max">
    <div class="reveal">
      <SectionLabel number="04" label="Media & Voice" />
      <h2
        id="media-heading"
        class="max-w-2xl font-display text-3xl tracking-tight text-paper sm:text-4xl"
      >
        Public briefings, not just private commits
      </h2>
      <p class="mt-4 max-w-2xl text-paper-muted">
        Teaching the law and hosting live technical culture — because the intersection
        only matters if people can hear it.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {
        channels.map((ch, i) => (
          <article
            class:list={[
              "reveal rounded-2xl border border-line bg-ink-elevated/60 p-6 sm:p-8",
              i === 0 && "reveal-delay-1",
              i === 1 && "reveal-delay-2",
            ]}
          >
            <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-brass">
              {ch.platform}
            </span>
            <h3 class="mt-3 font-display text-2xl text-paper">{ch.name}</h3>
            <p class="mt-3 text-sm leading-relaxed text-paper-muted">{ch.blurb}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
