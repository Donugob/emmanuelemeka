---
import SectionHead from "./SectionHead.astro";
import { leadership } from "../data/cv";
---

<section id="leadership" class="cv-section" aria-labelledby="leadership-h">
  <SectionHead id="leadership" />

  <div class="cv-group">
    {
      leadership.map((position) => (
        <article>
          <div class="entry-head">
            <h3 class="text-[1.0625rem] font-medium">{position.title}</h3>
            <time class="meta">{position.period}</time>
          </div>
          <p class="mt-0.5 text-ink-2">{position.org}</p>
          <p class="measure mt-1.5 text-ink-2">{position.note}</p>
        </article>
      ))
    }
  </div>
</section>
