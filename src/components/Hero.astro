---
---

<section
  id="top"
  class="section-pad relative pt-28 pb-20 sm:pt-36 sm:pb-28 lg:pt-40"
  aria-labelledby="hero-heading"
>
  <div class="section-max">
    <div class="grid items-start gap-12 lg:grid-cols-12 lg:gap-10">
      <!-- Main copy -->
      <div class="lg:col-span-7">
        <p class="reveal font-mono text-xs uppercase tracking-[0.22em] text-brass">
          Full-Stack Engineer · Founder · Legal Scholar
        </p>

        <h1
          id="hero-heading"
          class="reveal reveal-delay-1 mt-5 font-display text-4xl leading-[1.08] tracking-tight text-paper sm:text-5xl lg:text-6xl"
        >
          Emeka Emmanuel Ugonna
          <span class="mt-2 block text-2xl text-paper-muted sm:text-3xl lg:text-4xl">
            <span class="text-brass">·</span> Ugo.B
          </span>
        </h1>

        <p
          class="reveal reveal-delay-2 mt-8 max-w-xl text-lg leading-relaxed text-paper-muted sm:text-xl"
        >
          I build high-concurrency digital platforms and work at the edge of tech law —
          from live voting infrastructure to cybercrime jurisprudence.
        </p>

        <div class="reveal reveal-delay-3 mt-10 flex flex-wrap items-center gap-3">
          <a
            href="#work"
            class="inline-flex items-center gap-2 rounded-full bg-brass px-6 py-3 text-sm font-semibold text-ink transition hover:bg-brass-bright"
          >
            View work
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M3 8h10M9 4l4 4-4 4"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
          <a
            href="#contact"
            class="inline-flex items-center rounded-full border border-line-strong px-6 py-3 text-sm font-medium text-paper transition hover:border-brass/50 hover:text-brass-bright"
          >
            Contact
          </a>
        </div>
      </div>

      <!-- Status brief card -->
      <aside class="reveal reveal-delay-2 lg:col-span-5 lg:pt-4" aria-label="Profile status">
        <div
          class="relative overflow-hidden rounded-2xl border border-line bg-ink-elevated/80 p-6 shadow-2xl shadow-black/40 sm:p-8"
        >
          <div
            class="pointer-events-none absolute -right-8 -top-8 h-32 w-32 rounded-full bg-brass/10 blur-2xl"
            aria-hidden="true"
          >
          </div>

          <div class="flex items-center justify-between border-b border-line pb-4">
            <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-brass">
              The Brief
            </span>
            <span
              class="inline-flex items-center gap-1.5 rounded-full border border-brass/30 bg-brass/10 px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-brass-bright"
            >
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-brass"></span>
              Active
            </span>
          </div>

          <dl class="mt-5 space-y-5">
            <div>
              <dt class="font-mono text-[10px] uppercase tracking-[0.16em] text-paper-muted">
                Status
              </dt>
              <dd class="mt-1 text-sm leading-snug text-paper">
                Final-year Law Student (500L), Imo State University
              </dd>
            </div>
            <div>
              <dt class="font-mono text-[10px] uppercase tracking-[0.16em] text-paper-muted">
                Studio
              </dt>
              <dd class="mt-1 text-sm leading-snug text-paper">
                Founder, <span class="text-brass-bright">Build With Ugo.B</span>
              </dd>
            </div>
            <div>
              <dt class="font-mono text-[10px] uppercase tracking-[0.16em] text-paper-muted">
                Flagship
              </dt>
              <dd class="mt-1 text-sm leading-snug text-paper">
                Votesphere — live voting infrastructure for high-stakes events
              </dd>
            </div>
            <div>
              <dt class="font-mono text-[10px] uppercase tracking-[0.16em] text-paper-muted">
                Focus
              </dt>
              <dd class="mt-1 text-sm leading-snug text-paper">
                Software systems × digital jurisprudence
              </dd>
            </div>
          </dl>

          <div class="mt-6 flex flex-wrap gap-2 border-t border-line pt-5">
            <span
              class="rounded-md border border-line bg-ink-soft px-2.5 py-1 font-mono text-[11px] text-paper-muted"
            >
              Next.js
            </span>
            <span
              class="rounded-md border border-line bg-ink-soft px-2.5 py-1 font-mono text-[11px] text-paper-muted"
            >
              Node
            </span>
            <span
              class="rounded-md border border-line bg-ink-soft px-2.5 py-1 font-mono text-[11px] text-paper-muted"
            >
              Postgres
            </span>
            <span
              class="rounded-md border border-line bg-ink-soft px-2.5 py-1 font-mono text-[11px] text-paper-muted"
            >
              Tech Law
            </span>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>
