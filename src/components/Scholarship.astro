---
import SectionLabel from "./SectionLabel.astro";

const competencies = [
  "Land Law",
  "Evidence Law",
  "Digital Tech Law",
  "Equity Contracts & Advisory",
  "Cybercrime Frameworks",
  "Constitutional Law",
];

const leadership = [
  {
    title: "Campus Director, LAWSAN",
    org: "Law Students' Association of Nigeria",
    note: "Award of Honor Recipient",
  },
  {
    title: "State Director",
    org: "Directorate of Students' Rights",
    note: "Student rights advocacy & leadership",
  },
  {
    title: "Chairman, Constitution Drafting Committee",
    org: "Omenwanne Age Grade",
    note: "Community constitutional frameworks & statutory structure",
  },
];
---

<section
  id="scholarship"
  class="section-pad border-t border-line py-20 sm:py-28"
  aria-labelledby="scholarship-heading"
>
  <div class="section-max">
    <div class="reveal">
      <SectionLabel number="02" label="Practice & Scholarship" />
      <h2
        id="scholarship-heading"
        class="max-w-2xl font-display text-3xl tracking-tight text-paper sm:text-4xl"
      >
        Law that understands the stack
      </h2>
      <p class="mt-4 max-w-2xl text-paper-muted">
        Final-year training with a research spine in cybercrime prosecution — and a
        practice interest in how founders, platforms, and communities are governed.
      </p>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-12">
      <!-- Research -->
      <article
        class="reveal reveal-delay-1 rounded-2xl border border-line bg-parchment/[0.04] p-6 sm:p-8 lg:col-span-7"
      >
        <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-brass">
          Specialized research
        </p>
        <h3 class="mt-4 font-display text-2xl leading-snug text-paper sm:text-3xl">
          The Challenges of Prosecuting Cybercrime Under the Nigerian Cybercrimes Act
          2015: An Analysis
        </h3>
        <p class="mt-5 max-w-prose text-sm leading-relaxed text-paper-muted">
          Mapping the gap between digital offending and courtroom reality — evidence,
          jurisdiction, procedure, and institutional capacity under Nigeria’s primary
          cybercrime statute.
        </p>
        <div class="mt-8">
          <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-paper-muted">
            Core competencies
          </p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {
              competencies.map((c) => (
                <li class="rounded-full border border-line bg-ink-elevated px-3 py-1.5 text-sm text-paper">
                  {c}
                </li>
              ))
            }
          </ul>
        </div>
      </article>

      <!-- Leadership -->
      <div class="reveal reveal-delay-2 space-y-4 lg:col-span-5">
        <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-brass">
          Leadership & governance
        </p>
        {
          leadership.map((item) => (
            <article class="rounded-xl border border-line bg-ink-elevated/70 p-5 transition hover:border-brass/25">
              <h3 class="font-medium text-paper">{item.title}</h3>
              <p class="mt-1 text-sm text-brass-bright/90">{item.org}</p>
              <p class="mt-2 text-sm text-paper-muted">{item.note}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
