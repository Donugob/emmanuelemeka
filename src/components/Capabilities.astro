---
import SectionLabel from "./SectionLabel.astro";

const groups = [
  {
    title: "Frontend",
    items: ["Next.js", "Astro", "React", "Tailwind CSS", "TypeScript", "HTML5 / CSS3"],
  },
  {
    title: "Backend & Data",
    items: ["Node.js", "Express", "Prisma ORM", "PostgreSQL (Supabase)", "REST & GraphQL"],
  },
  {
    title: "DevOps & Infra",
    items: ["Fedora Linux", "Coolify", "Hetzner", "Vercel", "ImageKit", "Open-weight AI (Gemma)"],
  },
  {
    title: "Creative & Law",
    items: [
      "Blender (3D / motion)",
      "Figma & UI/UX",
      "Cybercrime frameworks",
      "Tech equity contracts",
      "Constitutional drafting",
    ],
  },
];
---

<section
  id="capabilities"
  class="section-pad border-t border-line py-20 sm:py-28"
  aria-labelledby="capabilities-heading"
>
  <div class="section-max">
    <div class="reveal">
      <SectionLabel number="03" label="Capabilities" />
      <h2
        id="capabilities-heading"
        class="max-w-2xl font-display text-3xl tracking-tight text-paper sm:text-4xl"
      >
        What I can own end-to-end
      </h2>
      <p class="mt-4 max-w-2xl text-paper-muted">
        Product surface to database to deploy — plus the legal and design judgment that
        keeps high-stakes systems honest.
      </p>
    </div>

    <div class="mt-14 grid gap-4 sm:grid-cols-2">
      {
        groups.map((group, i) => (
          <div
            class:list={[
              "reveal rounded-2xl border border-line bg-ink-elevated/50 p-6",
              i === 0 && "reveal-delay-1",
              i === 1 && "reveal-delay-2",
              i === 2 && "reveal-delay-3",
              i === 3 && "reveal-delay-4",
            ]}
          >
            <h3 class="font-mono text-xs uppercase tracking-[0.16em] text-brass">
              {group.title}
            </h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded-md border border-line bg-ink-soft px-2.5 py-1.5 text-sm text-paper">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
