---
const cvPdf = "/cv/Emeka-Emmanuel-Ugonna-CV.pdf";
---

<header
  class="no-print fixed inset-x-0 top-0 z-50 border-b border-desk-line bg-desk/95 backdrop-blur-md"
  style="padding-top: env(safe-area-inset-top, 0);"
>
  <div
    id="read-progress"
    class="pointer-events-none absolute inset-x-0 bottom-0 h-[2px] bg-brass"
    aria-hidden="true"
  >
  </div>

  <nav
    class="mx-auto flex h-14 w-full max-w-6xl min-w-0 items-center justify-between gap-2 px-3 sm:gap-4 sm:px-5 md:px-8"
    aria-label="Primary"
  >
    <a href="#top" class="group flex min-w-0 shrink items-baseline gap-2">
      <span
        class="font-display text-base tracking-tight text-desk-text transition group-hover:text-brass-bright sm:text-lg"
      >
        Ugo.B
      </span>
      <span
        class="hidden truncate font-mono text-[10px] uppercase tracking-[0.16em] text-desk-muted sm:inline"
      >
        CV
      </span>
    </a>

    <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
      <a
        href={cvPdf}
        download="Emeka-Emmanuel-Ugonna-CV.pdf"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-desk-line text-desk-muted transition active:scale-95 hover:border-brass/40 hover:text-desk-text sm:hidden"
        aria-label="Download professional CV PDF"
        title="Download CV PDF"
      >
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M8 2v8m0 0L5 7m3 3l3-3M3 12.5h10"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>

      <button
        type="button"
        id="btn-print"
        class="hidden items-center gap-1.5 rounded-full border border-desk-line px-3 py-2 text-xs text-desk-muted transition hover:border-brass/40 hover:text-desk-text sm:inline-flex"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M4 6V2h8v4M4 12H3a1 1 0 01-1-1V7a1 1 0 011-1h10a1 1 0 011 1v4a1 1 0 01-1 1h-1M4 10h8v4H4v-4z"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linejoin="round"></path>
        </svg>
        Print CV
      </button>
      <a
        href={cvPdf}
        download="Emeka-Emmanuel-Ugonna-CV.pdf"
        class="hidden items-center gap-1.5 rounded-full border border-desk-line px-3 py-2 text-xs text-desk-muted transition hover:border-brass/40 hover:text-desk-text sm:inline-flex"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M8 2v8m0 0L5 7m3 3l3-3M3 12.5h10"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        PDF
      </a>
      <a
        href="#contact"
        class="rounded-full bg-brass px-3 py-2 text-xs font-semibold text-ink transition active:scale-95 hover:bg-brass-bright sm:px-4"
      >
        Contact
      </a>
    </div>
  </nav>
</header>
