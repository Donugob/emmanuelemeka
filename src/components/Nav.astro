---
---

<header
  class="no-print fixed inset-x-0 top-0 z-50 border-b border-desk-line bg-desk/85 backdrop-blur-md"
>
  <div
    id="read-progress"
    class="pointer-events-none absolute inset-x-0 bottom-0 h-[2px] bg-brass"
    aria-hidden="true"
  >
  </div>

  <nav
    class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8"
    aria-label="Primary"
  >
    <a href="#top" class="group flex items-baseline gap-2">
      <span
        class="font-display text-lg tracking-tight text-desk-text transition group-hover:text-brass-bright"
      >
        Ugo.B
      </span>
      <span class="hidden font-mono text-[10px] uppercase tracking-[0.18em] text-desk-muted sm:inline">
        Curriculum Vitae
      </span>
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <button
        type="button"
        id="btn-print"
        class="hidden items-center gap-1.5 rounded-full border border-desk-line px-3 py-1.5 text-xs text-desk-muted transition hover:border-brass/40 hover:text-desk-text sm:inline-flex"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M4 6V2h8v4M4 12H3a1 1 0 01-1-1V7a1 1 0 011-1h10a1 1 0 011 1v4a1 1 0 01-1 1h-1M4 10h8v4H4v-4z"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linejoin="round"></path>
        </svg>
        Print
      </button>
      <a
        href="#contact"
        class="rounded-full bg-brass px-4 py-1.5 text-xs font-semibold text-ink transition hover:bg-brass-bright"
      >
        Contact
      </a>
    </div>
  </nav>
</header>
