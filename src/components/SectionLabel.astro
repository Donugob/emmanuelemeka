---
interface Props {
  number: string;
  label: string;
}

const { number, label } = Astro.props;
---

<div class="mb-8 flex items-center gap-3">
  <span class="font-mono text-xs tracking-[0.18em] text-brass">{number}</span>
  <span class="h-px w-8 bg-brass/50" aria-hidden="true"></span>
  <span class="font-mono text-xs uppercase tracking-[0.18em] text-paper-muted">
    {label}
  </span>
</div>
