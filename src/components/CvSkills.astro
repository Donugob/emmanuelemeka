---
import SectionHead from "./SectionHead.astro";
import { skills } from "../data/cv";
---

<section id="skills" class="cv-section" aria-labelledby="skills-h">
  <SectionHead id="skills" />

  <!--
    Label beside a run of tools, so the section reads as a table rather than a
    field of chips — and needs no second column to align.
  -->
  <dl class="cv-group space-y-3">
    {
      skills.map((group) => (
        <div class="field">
          <dt class="meta">{group.title}</dt>
          <dd class="m-0">{group.items.join(", ")}</dd>
        </div>
      ))
    }
  </dl>
</section>
