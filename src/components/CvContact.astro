---
const email = "contactugob@gmail.com";
const cvPdf = "/cv/Emeka-Emmanuel-Ugonna-CV.pdf";
---

<section
  id="contact"
  class="cv-section reveal reveal-delay-1 pt-8 pb-2 sm:pt-10"
  aria-labelledby="contact-h"
>
  <div class="mb-3 flex items-center gap-3">
    <h2 id="contact-h" class="cv-section-title">07 — Contact & Engagements</h2>
    <div class="cv-rule flex-1"></div>
  </div>

  <div
    class="rounded-xl border border-chip-border bg-gradient-to-br from-chip/80 to-paper px-4 py-5 sm:px-6 sm:py-6"
  >
    <p class="font-display text-xl leading-snug text-ink sm:text-3xl">
      Open to builds that have to hold up.
    </p>
    <p class="mt-3 max-w-prose text-sm leading-relaxed text-ink-soft">
      Product engineering, platform builds, agency work via Build With Ugo.B, and tech–law
      conversations around cybercrime, equity, and digital governance.
    </p>

    <div class="mt-5 flex flex-col gap-2.5 sm:mt-6 sm:flex-row sm:flex-wrap sm:items-center sm:gap-3">
      <a
        href={`mailto:${email}`}
        class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-paper transition hover:bg-ink-soft"
      >
        Email me
      </a>
      <button
        type="button"
        id="btn-copy-email"
        class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full border border-chip-border bg-paper px-5 py-2.5 text-sm font-medium text-ink-soft transition hover:border-[#8a7340] hover:text-ink"
        data-email={email}
      >
        <span data-copy-label>Copy email</span>
      </button>
      <a
        href={cvPdf}
        download="Emeka-Emmanuel-Ugonna-CV.pdf"
        class="no-print inline-flex min-h-11 items-center justify-center gap-2 rounded-full border border-chip-border bg-paper px-5 py-2.5 text-sm font-medium text-ink-soft transition hover:border-[#8a7340] hover:text-ink"
      >
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M8 2v8m0 0L5 7m3 3l3-3M3 12.5h10"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        Download CV (PDF)
      </a>
      <button
        type="button"
        id="btn-print-mobile"
        class="no-print hidden min-h-11 items-center justify-center gap-2 rounded-full border border-chip-border bg-paper px-5 py-2.5 text-sm font-medium text-ink-soft transition hover:border-[#8a7340] hover:text-ink sm:inline-flex"
      >
        Print CV
      </button>
    </div>

    <p class="mt-4 break-all font-mono text-xs text-ink-muted">{email}</p>

    <ul class="mt-5 grid gap-2.5 border-t border-rule pt-5 text-sm text-ink-soft sm:grid-cols-2">
      {
        [
          "High-concurrency web platforms & SaaS",
          "Custom agency builds & audits",
          "Tech equity & founder contracts (advisory)",
          "Speaking, Spaces, legal-tech education",
        ].map((item) => (
          <li class="flex gap-2">
            <span class="shrink-0 text-[#8a7340]">✓</span>
            {item}
          </li>
        ))
      }
    </ul>
  </div>

  <footer
    class="mt-8 flex flex-col gap-3 border-t border-rule pt-6 text-xs text-ink-muted sm:mt-10 sm:flex-row sm:flex-wrap sm:items-end sm:justify-between"
  >
    <div>
      <p class="font-display text-base text-ink">Emeka Emmanuel Ugonna · Ugo.B</p>
      <p class="mt-1 font-mono">emmanuelemeka.cv</p>
    </div>
    <p class="font-mono">References available on request</p>
  </footer>
</section>
