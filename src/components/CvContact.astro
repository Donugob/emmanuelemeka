---
const email = "contactugob@gmail.com";
const cvPdf = "/cv/Emeka-Emmanuel-Ugonna-CV.pdf";
---

<section
  id="contact"
  class="cv-section reveal reveal-delay-1 pt-7 pb-1 sm:pt-10"
  aria-labelledby="contact-h"
>
  <div class="mb-2.5 flex min-w-0 items-center gap-2 sm:mb-3 sm:gap-3">
    <h2 id="contact-h" class="cv-section-title shrink-0">07 — Contact</h2>
    <div class="cv-rule"></div>
  </div>

  <div
    class="min-w-0 rounded-xl border border-chip-border bg-gradient-to-br from-chip/80 to-paper px-3.5 py-4 sm:px-6 sm:py-6"
  >
    <p class="font-display text-xl leading-snug text-ink sm:text-3xl">
      Open to builds that have to hold up.
    </p>
    <p class="mt-2.5 max-w-prose text-[13px] leading-relaxed text-ink-soft sm:mt-3 sm:text-sm">
      Product engineering, platform builds, agency work via Build With Ugo.B, and tech–law
      conversations around cybercrime, equity, and digital governance.
    </p>

    <div class="mt-4 flex flex-col gap-2 sm:mt-6 sm:flex-row sm:flex-wrap sm:items-center sm:gap-3">
      <a
        href={`mailto:${email}`}
        class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-paper transition active:scale-[0.98] hover:bg-ink-soft sm:w-auto"
      >
        Email me
      </a>
      <button
        type="button"
        id="btn-copy-email"
        class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-full border border-chip-border bg-paper px-5 py-2.5 text-sm font-medium text-ink-soft transition active:scale-[0.98] hover:border-[#8a7340] hover:text-ink sm:w-auto"
        data-email={email}
      >
        <span data-copy-label>Copy email</span>
      </button>
      <a
        href={cvPdf}
        download="Emeka-Emmanuel-Ugonna-CV.pdf"
        class="no-print inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-full border border-chip-border bg-paper px-5 py-2.5 text-sm font-medium text-ink-soft transition active:scale-[0.98] hover:border-[#8a7340] hover:text-ink sm:w-auto"
      >
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M8 2v8m0 0L5 7m3 3l3-3M3 12.5h10"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        Download CV (PDF)
      </a>
      <button
        type="button"
        id="btn-print-mobile"
        class="no-print hidden min-h-11 items-center justify-center gap-2 rounded-full border border-chip-border bg-paper px-5 py-2.5 text-sm font-medium text-ink-soft transition hover:border-[#8a7340] hover:text-ink sm:inline-flex"
      >
        Print CV
      </button>
    </div>

    <p class="mt-3 break-anywhere font-mono text-[11px] text-ink-muted sm:mt-4 sm:text-xs">
      {email}
    </p>

    <ul
      class="mt-4 grid grid-cols-1 gap-2 border-t border-rule pt-4 text-[13px] text-ink-soft sm:mt-5 sm:grid-cols-2 sm:gap-2.5 sm:text-sm"
    >
      {
        [
          "High-concurrency web platforms & SaaS",
          "Custom agency builds & audits",
          "Tech equity & founder contracts (advisory)",
          "Speaking, Spaces, legal-tech education",
        ].map((item) => (
          <li class="flex gap-2">
            <span class="shrink-0 text-[#8a7340]">✓</span>
            <span class="min-w-0">{item}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <footer
    class="mt-7 flex min-w-0 flex-col gap-2 border-t border-rule pt-5 text-[11px] text-ink-muted sm:mt-10 sm:flex-row sm:items-end sm:justify-between sm:gap-3 sm:pt-6 sm:text-xs"
  >
    <div class="min-w-0">
      <p class="font-display text-[15px] text-ink sm:text-base">Emeka Emmanuel Ugonna · Ugo.B</p>
      <p class="mt-1 font-mono">emmanuelemeka.cv</p>
    </div>
    <p class="font-mono">References available on request</p>
  </footer>
</section>
