---
import SectionHead from "./SectionHead.astro";
import { availability, contact, cvPdf, identity } from "../data/cv";
---

<section id="contact" class="cv-section" aria-labelledby="contact-h">
  <SectionHead id="contact" />

  <!-- Web-page voice. A CV does not pitch. -->
  <div class="cv-group no-print">
    <p class="measure text-[1.25rem] leading-snug">Open to builds that have to hold up.</p>
    <p class="measure mt-3 text-ink-2">
      Product engineering, platform builds, agency work through Build With Ugo.B, and tech–law
      conversations around cybercrime, equity, and digital governance.
    </p>
  </div>

  <ul class="cv-group measure space-y-1">
    {
      availability.map((item) => (
        <li class="flex gap-3">
          <span class="text-ink-2" aria-hidden="true">
            –
          </span>
          <span>{item}</span>
        </li>
      ))
    }
  </ul>

  <div class="cv-group no-print flex flex-wrap items-center gap-x-7 gap-y-2 text-[0.9375rem]">
    <a href={`mailto:${contact.email}`}>Email me</a>
    <a href={cvPdf} download="Emeka-Emmanuel-Ugonna-CV.pdf">Download CV as PDF</a>
    <button type="button" id="btn-print-footer" class="action">Print</button>
  </div>

  <!-- The name is at the top of the document; repeating it here just pushed
       the footer onto a page of its own. -->
  <footer class="mt-12 border-t border-rule pt-5">
    <p class="meta">{identity.domain}</p>
    <p class="text-ink-2 mt-0.5">References available on request</p>
  </footer>
</section>
