---
import SectionHead from "./SectionHead.astro";
import { experience } from "../data/cv";
---

<section id="experience" class="cv-section" aria-labelledby="experience-h">
  <SectionHead id="experience" />

  <div class="cv-group">
    {
      experience.map((role) => (
        <article>
          <div class="entry-head">
            <h3 class="text-[1.0625rem] font-medium">{role.title}</h3>
            <time class="meta">{role.period}</time>
          </div>

          <p class="mt-0.5 text-ink-2">
            {role.orgUrl ? (
              <a href={role.orgUrl} target="_blank" rel="noopener noreferrer">
                {role.org}
              </a>
            ) : (
              <span>{role.org}</span>
            )}
            <span>, {role.location}</span>
          </p>

          <p class="measure mt-2.5 text-ink-2">{role.summary}</p>

          <ul class="measure mt-3 space-y-1">
            {role.bullets.map((bullet) => (
              <li class="flex gap-3">
                <span class="text-ink-2" aria-hidden="true">
                  –
                </span>
                <span>{bullet}</span>
              </li>
            ))}
          </ul>

          {role.metrics && role.metrics.length > 0 && (
            <p class="measure mt-3 text-ink-2">
              {role.metrics.map((metric) => `${metric.value} ${metric.label}`).join("; ")}.
            </p>
          )}
        </article>
      ))
    }
  </div>
</section>
