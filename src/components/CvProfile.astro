---
import SectionHead from "./SectionHead.astro";
import { profile } from "../data/cv";

const facts = [
  { term: "Focus", detail: "Software systems and tech law" },
  { term: "Studio", detail: "Build With Ugo.B" },
  { term: "Flagship", detail: "Votesphere" },
];
---

<section id="profile" class="cv-section" aria-labelledby="profile-h">
  <SectionHead id="profile" />

  <p class="cv-group measure text-ink-2">{profile}</p>

  <dl class="mt-7 space-y-1.5">
    {
      facts.map((fact) => (
        <div class="field">
          <dt class="meta">{fact.term}</dt>
          <dd class="m-0">{fact.detail}</dd>
        </div>
      ))
    }
  </dl>
</section>
