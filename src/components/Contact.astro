---
import SectionLabel from "./SectionLabel.astro";
---

<section
  id="contact"
  class="section-pad border-t border-line py-20 sm:py-28"
  aria-labelledby="contact-heading"
>
  <div class="section-max">
    <div class="reveal overflow-hidden rounded-3xl border border-line bg-ink-elevated">
      <div class="grid lg:grid-cols-12">
        <div class="p-8 sm:p-10 lg:col-span-7 lg:p-12">
          <SectionLabel number="05" label="Contact" />
          <h2
            id="contact-heading"
            class="font-display text-3xl tracking-tight text-paper sm:text-4xl lg:text-5xl"
          >
            Let’s build something that has to hold up
          </h2>
          <p class="mt-5 max-w-lg text-paper-muted">
            Open to product engineering, platform builds, agency engagements via Build
            With Ugo.B, and tech–law conversations around cybercrime, equity, and digital
            governance.
          </p>

          <div class="mt-10 flex flex-wrap gap-3">
            <a
              href="mailto:hello@emmanuelemeka.cv"
              class="inline-flex items-center gap-2 rounded-full bg-brass px-6 py-3 text-sm font-semibold text-ink transition hover:bg-brass-bright"
            >
              Email me
            </a>
            <a
              href="#work"
              class="inline-flex items-center rounded-full border border-line-strong px-6 py-3 text-sm font-medium text-paper transition hover:border-brass/50"
            >
              Back to work
            </a>
          </div>

          <p class="mt-8 font-mono text-xs text-paper-muted">
            Prefer a different channel? Replace this mailto once your public inbox is
            confirmed — placeholder:
            <span class="text-brass">hello@emmanuelemeka.cv</span>
          </p>
        </div>

        <div
          class="relative border-t border-line bg-ink-soft/50 p-8 sm:p-10 lg:col-span-5 lg:border-l lg:border-t-0 lg:p-12"
        >
          <div
            class="pointer-events-none absolute inset-0 opacity-40"
            style="background: radial-gradient(circle at 80% 20%, rgba(196,163,90,0.15), transparent 55%);"
            aria-hidden="true"
          >
          </div>
          <div class="relative">
            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-brass">
              Engagements
            </p>
            <ul class="mt-6 space-y-4">
              {
                [
                  "High-concurrency web platforms & SaaS",
                  "Custom agency builds & audits",
                  "Tech equity & founder contracts (advisory)",
                  "Speaking, Spaces, legal-tech education",
                ].map((item) => (
                  <li class="flex gap-3 text-sm text-paper">
                    <span
                      class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brass"
                      aria-hidden="true"
                    />
                    {item}
                  </li>
                ))
              }
            </ul>
            <div class="mt-10 rounded-xl border border-line bg-ink-elevated/80 p-4">
              <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-paper-muted">
                Domain
              </p>
              <p class="mt-1 font-display text-xl text-paper">emmanuelemeka.cv</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
