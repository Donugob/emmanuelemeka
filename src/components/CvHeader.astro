---
import { identity, contact, cvPdf, printOnly } from "../data/cv";
---

<header id="top" class="pt-14 sm:pt-20">
  <h1
    class="masthead-name text-[clamp(2rem,5vw,3rem)] font-semibold leading-[1.05] tracking-tight"
  >
    {identity.fullName}
  </h1>

  <div class="masthead-rule mt-5 mb-5"></div>

  <p class="text-[1.0625rem] font-medium">{identity.moniker}</p>
  <p class="mt-0.5 text-ink-2">{identity.headline}</p>
  <p class="meta mt-1.5">{identity.standing}</p>

  <!--
    Phone and postal address are printed but never published to the web page —
    the only two facts this document keeps to itself.
  -->
  <p class="print-only meta mt-1">{printOnly.location} · {printOnly.phone}</p>

  <ul class="mt-7 flex flex-wrap gap-x-7 gap-y-1.5 text-[0.9375rem]">
    <li>
      <a href={`mailto:${contact.email}`} class="unbreakable">{contact.email}</a>
    </li>
    <li>
      <a href={contact.x.href} target="_blank" rel="noopener noreferrer">{contact.x.label}</a>
    </li>
    <li>
      <a href={contact.product.href} target="_blank" rel="noopener noreferrer">
        {contact.product.label}
      </a>
    </li>
  </ul>

  <div class="no-print mt-5 flex flex-wrap items-center gap-x-7 gap-y-2 text-[0.9375rem]">
    <a href={cvPdf} download="Emeka-Emmanuel-Ugonna-CV.pdf">Download CV as PDF</a>
    <button type="button" id="btn-print" class="action">Print</button>
    <button type="button" id="btn-copy-email" class="action" data-email={contact.email}>
      <span data-copy-label>Copy email</span>
    </button>
  </div>
</header>
