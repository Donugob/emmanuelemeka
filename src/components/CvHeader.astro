---
const contacts = [
  { label: "emmanuelemeka.cv", href: "https://emmanuelemeka.cv", external: true },
  { label: "hello@emmanuelemeka.cv", href: "mailto:hello@emmanuelemeka.cv", external: false },
  { label: "Votesphere.com.ng", href: "https://votesphere.com.ng", external: true },
];
---

<header id="top" class="reveal border-b border-rule pb-8">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="font-mono text-[10px] uppercase tracking-[0.24em] text-[#8a7340]">
        Curriculum Vitae
      </p>
      <h1 class="mt-2 font-display text-4xl leading-[1.05] tracking-tight text-ink sm:text-5xl">
        Emeka Emmanuel Ugonna
      </h1>
      <p class="mt-2 font-display text-xl italic text-ink-soft sm:text-2xl">
        Ugo.B
      </p>
      <p class="mt-3 max-w-xl text-sm font-medium tracking-wide text-ink-soft sm:text-base">
        Full-Stack Software Engineer · Founder · Legal Scholar
      </p>
    </div>

    <div
      class="rounded-lg border border-chip-border bg-chip/60 px-3 py-2 text-right font-mono text-[10px] uppercase tracking-wider text-ink-muted"
    >
      <p class="text-[#8a7340]">Status</p>
      <p class="mt-1 normal-case tracking-normal text-ink-soft">Final-year Law · 500L</p>
      <p class="normal-case tracking-normal text-ink-soft">IMSU · Nigeria</p>
    </div>
  </div>

  <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 border-t border-rule pt-4 text-sm text-ink-soft">
    {
      contacts.map((c) => (
        <li>
          <a
            href={c.href}
            class="underline decoration-rule underline-offset-4 transition hover:text-ink hover:decoration-[#8a7340]"
            target={c.external ? "_blank" : undefined}
            rel={c.external ? "noopener noreferrer" : undefined}
          >
            {c.label}
          </a>
        </li>
      ))
    }
  </ul>
</header>
