---
const contacts = [
  { label: "contactugob@gmail.com", href: "mailto:contactugob@gmail.com", external: false },
  { label: "x.com/Don_ugob", href: "https://x.com/Don_ugob", external: true },
  { label: "Votesphere.com.ng", href: "https://votesphere.com.ng", external: true },
];
---

<header id="top" class="reveal border-b border-rule pb-5 sm:pb-8">
  <div class="flex min-w-0 flex-col gap-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
    <div class="min-w-0 flex-1">
      <h1
        class="break-anywhere font-display text-[1.65rem] leading-[1.1] tracking-tight text-ink sm:text-4xl md:text-5xl"
      >
        Emeka Emmanuel Ugonna
      </h1>
      <p class="mt-1 font-display text-base italic text-ink-soft sm:mt-2 sm:text-2xl">Ugo.B</p>
      <p
        class="mt-2 text-[12.5px] font-medium leading-snug text-ink-soft sm:mt-3 sm:text-base"
      >
        Full-Stack Software Engineer · Founder · Legal Scholar
      </p>
    </div>

    <div
      class="w-full rounded-lg border border-chip-border bg-chip/60 px-3 py-2 font-mono text-[10px] uppercase tracking-wider text-ink-muted sm:w-auto sm:shrink-0 sm:text-right"
    >
      <p class="text-[#8a7340]">Status</p>
      <p class="mt-1 normal-case tracking-normal text-ink-soft">Final-year Law · 500L</p>
      <p class="normal-case tracking-normal text-ink-soft">IMSU · Nigeria</p>
    </div>
  </div>

  <ul
    class="mt-4 flex min-w-0 flex-col gap-1.5 border-t border-rule pt-3.5 text-[12.5px] text-ink-soft sm:mt-6 sm:flex-row sm:flex-wrap sm:gap-x-5 sm:gap-y-2 sm:pt-4 sm:text-sm"
  >
    {
      contacts.map((c) => (
        <li class="min-w-0 max-w-full">
          <a
            href={c.href}
            class="break-anywhere underline decoration-rule underline-offset-4 transition hover:text-ink hover:decoration-[#8a7340]"
            target={c.external ? "_blank" : undefined}
            rel={c.external ? "noopener noreferrer" : undefined}
          >
            {c.label}
          </a>
        </li>
      ))
    }
  </ul>
</header>
