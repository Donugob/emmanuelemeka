---
import SectionHead from "./SectionHead.astro";
import { education, research } from "../data/cv";
---

<section id="education" class="cv-section" aria-labelledby="education-h">
  <SectionHead id="education" />

  <div class="cv-group">
    <article>
      <div class="entry-head">
        <h3 class="text-[1.0625rem] font-medium">{education.degree}</h3>
        <time class="meta">{education.period}</time>
      </div>
      <p class="mt-0.5">{education.distinction}</p>
      <p class="text-ink-2">{education.institution}</p>
    </article>

    <article>
      <p class="meta">Specialized research</p>
      <h3 class="measure mt-1.5 text-[1.0625rem] font-medium leading-snug">{research.title}</h3>
      <p class="measure mt-2.5 text-ink-2">{research.body}</p>
      <p class="measure mt-3 text-ink-2">{research.competencies.join(", ")}</p>

      <p class="meta mt-4">Related publications and topics</p>
      <ul class="measure mt-1.5 space-y-1">
        {
          research.related.map((topic) => (
            <li class="flex gap-3">
              <span class="text-ink-2" aria-hidden="true">
                –
              </span>
              <span>{topic}</span>
            </li>
          ))
        }
      </ul>
    </article>
  </div>
</section>
