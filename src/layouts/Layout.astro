---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Emeka Emmanuel Ugonna · Ugo.B — Curriculum Vitae",
  description = "Interactive curriculum vitae of Emeka Emmanuel Ugonna (Ugo.B) — full-stack software engineer, founder, and legal scholar. Votesphere, Build With Ugo.B, and digital jurisprudence.",
} = Astro.props;

const canonical = "https://emmanuelemeka.cv";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!--
      Device-width + initial-scale=1 is required.
      maximum-scale is intentionally NOT locked (accessibility).
      Horizontal overflow was the real “zoomed in” culprit — fixed in CSS.
    -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Emeka Emmanuel Ugonna" />
    <meta name="theme-color" content="#0C0E12" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="emmanuelemeka.cv" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-brass focus:px-4 focus:py-2 focus:font-medium focus:text-ink"
    >
      Skip to content
    </a>
    <slot />

    <script>
      // ——— Reveal on scroll ———
      const revealObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -4% 0px", threshold: 0.04 },
      );
      document.querySelectorAll(".reveal").forEach((el) => revealObserver.observe(el));

      // ——— Reading progress ———
      const progress = document.getElementById("read-progress");
      const paper = document.querySelector(".cv-paper");

      const updateProgress = () => {
        if (!progress || !paper) return;
        const rect = paper.getBoundingClientRect();
        const total = Math.max(paper.scrollHeight - window.innerHeight, 1);
        const scrolled = Math.min(Math.max(-rect.top, 0), total);
        progress.style.transform = `scaleX(${scrolled / total})`;
      };

      window.addEventListener("scroll", updateProgress, { passive: true });
      window.addEventListener("resize", updateProgress, { passive: true });
      updateProgress();

      // ——— Active TOC section ———
      const sectionIds = [
        "profile",
        "experience",
        "education",
        "leadership",
        "skills",
        "media",
        "contact",
      ];
      const tocLinks = document.querySelectorAll<HTMLElement>("[data-toc]");

      const setActive = (id: string) => {
        tocLinks.forEach((link) => {
          link.classList.toggle("is-active", link.dataset.toc === id);
        });
        // Keep active chip visible in the horizontal strip
        const activeChip = document.querySelector<HTMLElement>(
          `#cv-toc-mobile [data-toc="${id}"]`,
        );
        activeChip?.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
      };

      const sectionObserver = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
          if (visible[0]?.target?.id) setActive(visible[0].target.id);
        },
        { rootMargin: "-30% 0px -50% 0px", threshold: [0.08, 0.2, 0.4] },
      );

      sectionIds.forEach((id) => {
        const el = document.getElementById(id);
        if (el) sectionObserver.observe(el);
      });

      // ——— Expandable experience rows ———
      document.querySelectorAll<HTMLButtonElement>("[data-exp-toggle]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const panelId = btn.getAttribute("aria-controls");
          const panel = panelId ? document.getElementById(panelId) : null;
          if (!panel) return;

          const open = panel.classList.toggle("is-open");
          btn.setAttribute("aria-expanded", open ? "true" : "false");
          const chevron = btn.querySelector(".exp-chevron");
          if (chevron instanceof HTMLElement) {
            chevron.style.transform = open ? "rotate(180deg)" : "";
          }
        });

        const panelId = btn.getAttribute("aria-controls");
        const panel = panelId ? document.getElementById(panelId) : null;
        if (panel?.classList.contains("is-open")) {
          const chevron = btn.querySelector(".exp-chevron");
          if (chevron instanceof HTMLElement) chevron.style.transform = "rotate(180deg)";
        }
      });

      // ——— Keyboard section jump (1–7) ———
      const keyMap: Record<string, string> = {
        "1": "profile",
        "2": "experience",
        "3": "education",
        "4": "leadership",
        "5": "skills",
        "6": "media",
        "7": "contact",
      };

      window.addEventListener("keydown", (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const tag = (e.target as HTMLElement)?.tagName;
        if (tag === "INPUT" || tag === "TEXTAREA" || (e.target as HTMLElement)?.isContentEditable)
          return;
        const id = keyMap[e.key];
        if (!id) return;
        const el = document.getElementById(id);
        if (el) {
          e.preventDefault();
          el.scrollIntoView({ behavior: "smooth", block: "start" });
          setActive(id);
        }
      });

      // ——— Print professional CV only ———
      const printCv = () => window.print();
      document.getElementById("btn-print")?.addEventListener("click", printCv);
      document.getElementById("btn-print-mobile")?.addEventListener("click", printCv);

      // ——— Copy email ———
      const copyBtn = document.getElementById("btn-copy-email");
      copyBtn?.addEventListener("click", async () => {
        const email = copyBtn.getAttribute("data-email") ?? "";
        const label = copyBtn.querySelector("[data-copy-label]");
        try {
          await navigator.clipboard.writeText(email);
          if (label) label.textContent = "Copied";
          setTimeout(() => {
            if (label) label.textContent = "Copy email";
          }, 1800);
        } catch {
          if (label) label.textContent = "Copy failed";
        }
      });
    </script>
  </body>
</html>
