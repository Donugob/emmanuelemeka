---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Toc from "../components/Toc.astro";
import CvHeader from "../components/CvHeader.astro";
import CvProfile from "../components/CvProfile.astro";
import CvExperience from "../components/CvExperience.astro";
import CvEducation from "../components/CvEducation.astro";
import CvLeadership from "../components/CvLeadership.astro";
import CvSkills from "../components/CvSkills.astro";
import CvMedia from "../components/CvMedia.astro";
import CvContact from "../components/CvContact.astro";
import ProfessionalCvPrint from "../components/ProfessionalCvPrint.astro";
---

<Layout>
  <Nav />
  <main
    id="main"
    class="screen-only w-full max-w-full min-w-0 px-3 pb-14 pt-[3.75rem] sm:px-5 sm:pb-20 sm:pt-20 md:px-8"
  >
    <div
      class="mx-auto grid w-full min-w-0 max-w-6xl grid-cols-1 gap-0 xl:grid-cols-[11rem_minmax(0,1fr)] xl:gap-12"
    >
      <Toc />

      <div class="min-w-0 w-full max-w-full">
        <article
          class="cv-paper relative rounded-md px-3.5 py-5 sm:rounded-lg sm:px-8 sm:py-10 md:px-12 md:py-12"
          aria-label="Interactive curriculum vitae of Emeka Emmanuel Ugonna"
        >
          <CvHeader />
          <CvProfile />
          <CvExperience />
          <CvEducation />
          <CvLeadership />
          <CvSkills />
          <CvMedia />
          <CvContact />
        </article>
      </div>
    </div>
  </main>

  <ProfessionalCvPrint />
</Layout>
