---
import Layout from "../layouts/Layout.astro";
import CvHeader from "../components/CvHeader.astro";
import Contents from "../components/Contents.astro";
import CvProfile from "../components/CvProfile.astro";
import CvExperience from "../components/CvExperience.astro";
import CvEducation from "../components/CvEducation.astro";
import CvLeadership from "../components/CvLeadership.astro";
import CvSkills from "../components/CvSkills.astro";
import CvMedia from "../components/CvMedia.astro";
import CvContact from "../components/CvContact.astro";
import BackToTop from "../components/BackToTop.astro";
---

<Layout>
  <!--
    One surface. This document is what prints — there is no second, print-only
    copy of the CV, so no fact appears in the HTML more than once.
  -->
  <main id="main" class="pb-24">
    <div class="sheet">
      <CvHeader />
      <Contents />
      <CvProfile />
      <CvExperience />
      <CvEducation />
      <CvLeadership />
      <CvSkills />
      <CvMedia />
      <CvContact />
    </div>
  </main>

  <BackToTop />
</Layout>
