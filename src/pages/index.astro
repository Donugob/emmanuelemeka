---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Toc from "../components/Toc.astro";
import CvHeader from "../components/CvHeader.astro";
import CvProfile from "../components/CvProfile.astro";
import CvExperience from "../components/CvExperience.astro";
import CvEducation from "../components/CvEducation.astro";
import CvLeadership from "../components/CvLeadership.astro";
import CvSkills from "../components/CvSkills.astro";
import CvMedia from "../components/CvMedia.astro";
import CvContact from "../components/CvContact.astro";
import ProfessionalCvPrint from "../components/ProfessionalCvPrint.astro";
---

<Layout>
  <Nav />
  <main id="main" class="screen-only px-3 pb-16 pt-[4.25rem] sm:px-6 sm:pb-20 sm:pt-20 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-0 xl:grid-cols-[11rem_minmax(0,1fr)] xl:gap-12">
      <Toc />

      <div class="min-w-0">
        <div class="relative">
          <div
            class="pointer-events-none absolute -inset-3 rounded-[2rem] bg-brass/5 blur-2xl no-print sm:-inset-4"
            aria-hidden="true"
          >
          </div>

          <article
            class="cv-paper relative rounded-sm px-4 py-6 sm:rounded-md sm:px-10 sm:py-12 md:px-14 md:py-14"
            aria-label="Interactive curriculum vitae of Emeka Emmanuel Ugonna"
          >
            <div
              class="pointer-events-none absolute left-2 top-2 h-2.5 w-2.5 border-l border-t border-rule no-print sm:left-4 sm:top-4 sm:h-3 sm:w-3"
              aria-hidden="true"
            >
            </div>
            <div
              class="pointer-events-none absolute right-2 top-2 h-2.5 w-2.5 border-r border-t border-rule no-print sm:right-4 sm:top-4 sm:h-3 sm:w-3"
              aria-hidden="true"
            >
            </div>
            <div
              class="pointer-events-none absolute bottom-2 left-2 h-2.5 w-2.5 border-b border-l border-rule no-print sm:bottom-4 sm:left-4 sm:h-3 sm:w-3"
              aria-hidden="true"
            >
            </div>
            <div
              class="pointer-events-none absolute bottom-2 right-2 h-2.5 w-2.5 border-b border-r border-rule no-print sm:bottom-4 sm:right-4 sm:h-3 sm:w-3"
              aria-hidden="true"
            >
            </div>

            <CvHeader />
            <CvProfile />
            <CvExperience />
            <CvEducation />
            <CvLeadership />
            <CvSkills />
            <CvMedia />
            <CvContact />
          </article>
        </div>
      </div>
    </div>
  </main>

  <!-- Professional CV for browser Print only -->
  <ProfessionalCvPrint />
</Layout>
